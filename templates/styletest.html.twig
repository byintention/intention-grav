        <script>
            // Internal TOC nav with hover
            document.addEventListener('DOMContentLoaded', function () {
                (function () {
                const headings = document.querySelectorAll('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]');
                if (!headings.length) return;
                const ul = document.createElement('ul');
                ul.className = 'toc-from-headings';
                headings.forEach(function (heading) {
                    const id = heading.id;
                    const li = document.createElement('li');
                    const a = document.createElement('a');
                    a.href = '#' + id;
                    a.textContent = heading.textContent.trim();
                    li.appendChild(a);
                    ul.appendChild(li);
                });
                const container = document.getElementById('toc'); // change to your target element
                if (container) container.appendChild(ul);
                })();
        
                // TOC scroll spy: last heading whose top is at/above OFFSET (stable up & down)
                const toc = document.querySelector('.toc-from-headings');
                if (!toc) return;
                const links = Array.from(toc.querySelectorAll('a[href^="#"]'));
                const ids = links
                    .map((a) => a.getAttribute('href').slice(1))
                    .filter(Boolean);
                const headings = ids
                    .map((id) => document.getElementById(id))
                    .filter(Boolean);
                if (!headings.length) return;
                const linkById = new Map(
                    links.map((a) => [a.getAttribute('href').slice(1), a]),
                );
                function setActive(id) {
                    links.forEach((a) => a.classList.toggle('is-active', false));
                    const active = linkById.get(id);
                    if (active) active.classList.add('is-active');
                }
                const offset = 120; // align with sticky header / scroll-margin-top
                function updateTocActive() {
                    let current = headings[0];
                    for (let i = 0; i < headings.length; i++) {
                        if (headings[i].getBoundingClientRect().top <= offset) {
                            current = headings[i];
                        }
                    }
                    setActive(current.id);
                }
                let tocTicking = false;
                window.addEventListener(
                    'scroll',
                    function () {
                        if (!tocTicking) {
                            requestAnimationFrame(function () {
                                updateTocActive();
                                tocTicking = false;
                            });
                            tocTicking = true;
                        }
                    },
                    { passive: true }
                );
                updateTocActive();

                // Contrast checker tabs
                (function () {
                    const root = document.getElementById('contrastChecker');
                    if (!root) return;
                    const tabs = root.querySelectorAll('.tabList [role="tab"]');
                    const panels = root.querySelectorAll('.tabContent');
                    tabs.forEach(function (tab) {
                        tab.addEventListener('click', function () {
                            const id = tab.getAttribute('data-id');
                            tabs.forEach(function (t) {
                                const on = t === tab;
                                t.setAttribute('aria-selected', on ? 'true' : 'false');
                                t.parentElement.classList.toggle('active', on);
                            });
                            panels.forEach(function (panel) {
                                panel.classList.toggle('active', panel.id === 'panel-' + id);
                            });
                        });
                    });
                })();

            });
        
        </script>
    </div>
{% endblock %}
