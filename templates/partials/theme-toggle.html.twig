<button type="button"
        class="theme-toggle"
        data-theme-toggle
        data-label-auto="Auto"
        data-label-light="Light"
        data-label-dark="Dark"
        data-aria-template="Appearance: %s"
        data-title-template="Appearance: %s (click to cycle)"
        aria-label="Appearance: Auto"
        title="Appearance: Auto (click to cycle)">
    <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 3v1.5M12 19.5V21M5.6 5.6l1.1 1.1M17.3 17.3l1.1 1.1M3 12h1.5M19.5 12H21M5.6 18.4l1.1-1.1M17.3 6.7l1.1-1.1"/>
    </svg>
    <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M21 14.3A9 9 0 1 1 9.7 3 7 7 0 0 0 21 14.3z"/>
    </svg>
    <svg class="icon icon-auto" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/>
        <path fill="currentColor" d="M12 5a7 7 0 0 0 0 14V5z"/>
    </svg>
</button>
