{% set tags = page.taxonomy.tag|default([]) %}
{% set categories = page.taxonomy.category|default([]) %}

<article class="card">
    {% include 'partials/blog-featured-image.html.twig' with { page: page, link: true, loading: 'lazy' } %}
    <div class="padded">
        <h4><a href="{{ page.url }}">{{ page.title|e('html') }}</a></h4>
        <p class="text-sm blog-meta">
            <time datetime="{{ page.date|date('c') }}">{{ page.date|date('j F Y') }}</time>
            {% for term in categories %}
                <span class="chip">{{ term|e('html') }}</span>
            {% endfor %}
            {% for term in tags %}
                <span class="chip">{{ term|e('html') }}</span>
            {% endfor %}
        </p>
        {% set excerpt = page.header.excerpt|default('')|trim %}
        {% if excerpt %}
            {{ excerpt|markdown|raw }}
        {% else %}
            {{ page.summary|raw }}
        {% endif %}
        <p><a href="{{ page.url }}">Read more ➞</a></p>
    </div>
</article>
