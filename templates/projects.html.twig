{% extends 'partials/base.html.twig' %}

{% set collection = page.collection() %}

{% block content %}
<div class="bb-panel-filler bb-panel-filler-large bg-text"></div>
    <section class="bb-section bb-panel-projects bg-grey">
        <div class="container">
            <header class="twelve columns blog-listing-header text-centre">
                <h1>{{ page.title|e('html') }}</h1>
                {% if page.content|striptags|trim is not empty %}
                    <div class="blog-listing-intro">{{ page.content|raw }}</div>
                {% endif %}
            </header>
        </div>
    </section>

    {% if collection.count %}
        {% for project in collection %}
            {% include 'partials/project-list-item.html.twig' with { page: project, reverse: loop.index is even } %}
        {% endfor %}
    {% else %}
        <section class="bb-section bb-panel-projects">
            <div class="container">
                <p class="twelve columns">No projects yet.</p>
            </div>
        </section>
    {% endif %}

    {% if config.plugins.pagination.enabled and collection.params.pagination %}
        <section class="bb-section bb-panel-projects" id="listing-footer">
            <div class="container">
                <div class="twelve columns">
                    {% include 'partials/pagination.html.twig' ignore missing with { base_url: page.url, pagination: collection.params.pagination } %}
                </div>
            </div>
        </section>
    {% endif %}
    <div class="bb-panel-filler bb-panel-filler-medium"></div>
{% endblock %}
