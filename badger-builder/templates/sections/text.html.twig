{% set image = bb_site_media(section.text_image ?? null) %}
{% set image_url = image ? bb_absolute_url(image.url) : null %}
{% set caption = section.text_image_caption|default('') %}

{% include 'partials/text-image.html.twig' with {
    id: 'panel-' ~ index,
    bg: section.text_background|default('transparent'),
    align: section.text_align|default('right'),
    extra_classes: section.text_overall_classes|default(''),
    body: section.text_body ? section.text_body|bb_markdown : '',
    image_url: image_url,
    image_alt: section.text_image_alt|default(''),
    caption: caption ? caption|bb_markdown : '',
} %}
