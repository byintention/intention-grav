{% set id = 'panel-' ~ index %}
{% set desktop_path = section.hero_image_desktop|default(section.hero_image|default('')) %}
{% set mobile_path = section.hero_image_mobile|default('') %}
{% set desktop = desktop_path ? bb_site_media(desktop_path) : null %}
{% set mobile = mobile_path ? bb_site_media(mobile_path) : null %}
{% set desktop_url = desktop ? bb_absolute_url(desktop.url) : null %}
{% set mobile_url = mobile ? bb_absolute_url(mobile.url) : null %}
{% set alt = section.hero_image_desktop_alt|default(section.hero_image_alt|default('')) %}
{% set align = section.hero_align|default('center') %}
{% set align_class = align == 'left' ? 'text-left' : (align == 'right' ? 'text-right' : 'text-centre') %}
{% set bg = section.hero_background|default('transparent') %}
{% if bg == 'none' %}{% set bg = 'transparent' %}{% endif %}
{% set overall = section.hero_overall_classes|default('') %}
{% set has_picture = desktop_url or mobile_url %}

{% set layout = section.hero_layout|default('full-width') %}
{% if layout == 'boxed' %}
<section id="{{ id|e('html_attr') }}" class="bb-section bb-panel-hero boxed {% if has_picture %} hero-has-image{% endif %}{% if overall %} {{ overall|e('html_attr') }}{% endif %}">
    <div class="banner">
        <div class="container bg-{{ bg|e('html_attr') }}">
            {% if has_picture %}
            <picture>
                {% if desktop_url and mobile_url %}
                <source media="(min-width: 600px)" srcset="{{ desktop_url|e('html_attr') }}">
                <img src="{{ mobile_url|e('html_attr') }}" alt="{{ alt|e('html_attr') }}" loading="eager" decoding="async">
                {% elseif desktop_url %}
                <img src="{{ desktop_url|e('html_attr') }}" alt="{{ alt|e('html_attr') }}" loading="eager" decoding="async">
                {% else %}
                <img src="{{ mobile_url|e('html_attr') }}" alt="{{ alt|e('html_attr') }}" loading="eager" decoding="async">
                {% endif %}
            </picture>
            <div class="bannerTint" aria-hidden="true"></div>
            {% endif %}
            <div class="inner">
                <div class="twelve columns {{ align_class|e('html_attr') }}">
                    {% if section.hero_body %}
                        {{ section.hero_body|bb_markdown|raw }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}
{% if layout == 'full-width' %}
<section id="{{ id|e('html_attr') }}" class="bb-section bb-panel-hero bg-{{ bg|e('html_attr') }}{% if has_picture %} hero-has-image{% endif %}{% if overall %} {{ overall|e('html_attr') }}{% endif %}">
    <div class="banner">
        {% if has_picture %}
        <picture>
            {% if desktop_url and mobile_url %}
            <source media="(min-width: 600px)" srcset="{{ desktop_url|e('html_attr') }}">
            <img src="{{ mobile_url|e('html_attr') }}" alt="{{ alt|e('html_attr') }}" loading="eager" decoding="async">
            {% elseif desktop_url %}
            <img src="{{ desktop_url|e('html_attr') }}" alt="{{ alt|e('html_attr') }}" loading="eager" decoding="async">
            {% else %}
            <img src="{{ mobile_url|e('html_attr') }}" alt="{{ alt|e('html_attr') }}" loading="eager" decoding="async">
            {% endif %}
        </picture>
        <div class="bannerTint" aria-hidden="true"></div>
        {% endif %}
        <div class="inner">
            <div class="container">
                <div class="twelve columns {{ align_class|e('html_attr') }}">
                    {% if section.hero_body %}
                        {{ section.hero_body|bb_markdown|raw }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}